# OpenRouter per i modelli AI (Gemini, Sonar, ecc.)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# URL dell'applicazione (richiesto da OpenRouter)
APP_URL="http://localhost:3000"

# Porta per il server Hono
PORT=3000

# Vercel Postgres (Per il database futuro)
POSTGRES_URL="your_vercel_postgres_url_here"
POSTGRES_PRISMA_URL="your_vercel_postgres_prisma_url_here"
POSTGRES_URL_NO_SSL="your_vercel_postgres_url_no_ssl_here"
POSTGRES_URL_NON_POOLING="your_vercel_postgres_url_non_pooling_here"
POSTGRES_USER="your_vercel_postgres_user_here"
POSTGRES_HOST="your_vercel_postgres_host_here"
POSTGRES_PASSWORD="your_vercel_postgres_password_here"
POSTGRES_DATABASE="your_vercel_postgres_database_here"
