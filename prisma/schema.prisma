generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String?
  role           String          @default("CLIENT") // ADMIN | CLIENT
  active         Boolean         @default(true) // l'admin può sospendere un utente
  tokenBalance   Int             @default(100000) // bonus di prova
  tokensUsed     Int             @default(0)
  firstName      String?
  lastName       String?
  phone          String?
  street         String?
  city           String?
  zipCode        String?
  companyName    String?
  vatNumber      String?
  companyLogoUrl String?
  website        String?
  agentMemory    String?
  emailSmtpHost  String?
  emailSmtpPort  Int?
  emailSmtpUser  String?
  emailSmtpPass  String?
  // Credenziali Social (Facebook). Il token e cifrato a riposo (AES-256-GCM).
  fbPageId       String?
  fbAccessToken  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  agents         AgentInstance[]
  sessions       ChatSession[]
  anagrafiche    Anagrafica[]
  prodotti       Prodotto[]
  documenti      Documento[]
  auditLogs      AuditLog[]
  scheduledJobs  ScheduledJob[]
}

// ===== SCHEDULER SOCIAL =====
// platform: FACEBOOK
// sourceType: GOOGLE_SHEET | EXCEL
// selectionMode: SEQUENTIAL | RANDOM
// status: ACTIVE | PAUSED
model ScheduledJob {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId        String?            // agente proprietario del job (multi-tenant)
  agent          AgentInstance?     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name           String
  platform       String             @default("FACEBOOK")
  status         String             @default("ACTIVE")
  cronExpression String
  timezone       String             @default("Europe/Rome")
  fbPageId       String? // pagina target di QUESTO job (un utente puo gestire piu pagine)
  fbPageName     String?
  sourceType     String             @default("GOOGLE_SHEET")
  sourceRef      String // URL Google Sheet oppure filename Excel in shared_data
  captionTemplate String?           // es. "{nome} a soli {prezzo}€! {descrizione}"
  aiCaption      Boolean            @default(true) // caption generata dall'AI (post "che vende")
  aiModel        String?            // modello OpenRouter per la caption (vuoto = default flash-lite)
  // Branding per-job (override del profilo): un utente puo gestire piu attivita/pagine
  bizName        String?
  bizAddress     String?
  bizWhatsapp    String?
  bizWebsite     String?
  postsPerRun    Int                @default(1) // quanti prodotti pubblicare ad ogni esecuzione
  selectionMode  String             @default("SEQUENTIAL")
  cursor         Int                @default(0)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  lastStatus     String?
  lastError      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  runs           ScheduledJobRun[]

  @@index([userId])
  @@index([status, nextRunAt])
}

model ScheduledJobRun {
  id         String       @id @default(uuid())
  jobId      String
  job        ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status     String       @default("OK") // OK | ERROR
  output     String?
  error      String?
  startedAt  DateTime     @default(now())
  finishedAt DateTime?

  @@index([jobId])
  @@index([jobId, startedAt])
}

model AgentInstance {
  id            String         @id @default(uuid())
  name          String
  slug          String?        @unique // per il link cliente /a/<slug>
  clientName    String?
  clientEmail   String?
  systemPrompt  String?
  // Social per-agente (token cifrato AES-256-GCM)
  fbPageId      String?
  fbAccessToken String?
  enabledTools  String? // CSV dei tool extra attivi; null = solo strumenti base
  // Token / crediti
  tokenBalance  Int            @default(1000000)
  tokensUsed    Int            @default(0)
  active        Boolean        @default(true)
  userId        String // admin che gestisce l'agente
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      ChatSession[]
  scheduledJobs ScheduledJob[]
  tokenUsages   TokenUsage[]
  recharges     Recharge[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
}

// Ledger consumi token per agente (pesati per modello)
model TokenUsage {
  id               String         @id @default(uuid())
  userId           String? // consumo attribuito all'utente (SaaS)
  agentId          String?
  agent            AgentInstance? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  model            String
  promptTokens     Int            @default(0)
  completionTokens Int            @default(0)
  weightedCredits  Int            @default(0) // token "pesati" scalati dal saldo
  source           String? // es. chat | social
  createdAt        DateTime       @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([agentId])
}

// Ricariche token (Stripe)
model Recharge {
  id              String        @id @default(uuid())
  agentId         String
  agent           AgentInstance @relation(fields: [agentId], references: [id], onDelete: Cascade)
  amountEur       Float
  tokens          Int
  stripeSessionId String?
  status          String        @default("PENDING") // PENDING | PAID | FAILED
  createdAt       DateTime      @default(now())

  @@index([agentId])
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String?
  agentId   String
  agent     AgentInstance @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([agentId])
  @@index([createdAt])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  documents Document[]
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

model Document {
  id        String          @id @default(uuid())
  messageId String
  message   ChatMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename  String
  filepath  String
  fileType  String
  sizeBytes Int?
  createdAt DateTime        @default(now())
  chunks    DocumentChunk[]

  @@index([messageId])
}

model DocumentChunk {
  id         String                       @id @default(uuid())
  documentId String
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  @@index([documentId])
}

// tipo: CLIENTE | FORNITORE | LEAD
model Anagrafica {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo              String      @default("CLIENTE")
  ragioneSociale    String
  pivaCf            String?
  email             String?
  telefono          String?
  indirizzoCompleto String?
  referente         String?
  noteAi            String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  documenti         Documento[] @relation("AnagraficaDocumenti")

  @@index([userId])
  @@index([userId, tipo])
}

// tipoArticolo: PRODOTTO_FISICO | SERVIZIO | ABBONAMENTO
model Prodotto {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku           String?
  nomeProdotto  String
  descrizione   String?
  categoria     String?
  prezzoVendita Float
  aliquotaIva   Float           @default(22)
  tipoArticolo  String          @default("SERVIZIO")
  attivo        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  righe         RigaDocumento[]

  @@index([userId])
}

// tipoDocumento: PREVENTIVO | FATTURA | ORDINE_FORNITORE
// stato: BOZZA | INVIATO | ACCETTATO | RIFIUTATO
model Documento {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  anagraficaId     String?
  anagrafica       Anagrafica?     @relation("AnagraficaDocumenti", fields: [anagraficaId], references: [id])
  tipoDocumento    String          @default("PREVENTIVO")
  stato            String          @default("BOZZA")
  numero           String
  oggetto          String?
  note             String?
  dataScadenza     DateTime?
  totaleImponibile Float           @default(0)
  totaleImposte    Float           @default(0)
  righe            RigaDocumento[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([anagraficaId])
  @@index([userId, tipoDocumento])
  @@index([userId, stato])
}

model RigaDocumento {
  id                      String    @id @default(uuid())
  documentoId             String
  documento               Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  prodottoId              String?
  prodotto                Prodotto? @relation(fields: [prodottoId], references: [id])
  descrizione             String
  quantita                Float     @default(1)
  prezzoUnitarioApplicato Float
  scontoPercentuale       Float     @default(0)
  aliquotaIva             Float     @default(22)
  createdAt               DateTime  @default(now())

  @@index([documentoId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  azione    String
  esito     String   @default("OK")
  dettagli  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}
